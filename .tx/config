# Workflow: backend extract, pull and compile
# Requires an authenticated Transifex CLI.
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel extract -F pyproject.toml -o marshmallow_utils/translations/messages.pot marshmallow_utils
# 3) $ tx pull -a
# 4) $ pybabel compile -d marshmallow_utils/translations

# Optional workflow: push extracted sources
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ tx push -s

# Optional workflow: new backend language
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel init -i marshmallow_utils/translations/messages.pot -d marshmallow_utils/translations -l <lang>
# 3) Translate the PO file, then compile:
#    $ pybabel compile -d marshmallow_utils/translations -l <lang>

[main]
host = https://app.transifex.com

[o:inveniosoftware:p:invenio:r:marshmallow-utils-messages]
file_filter = marshmallow_utils/translations/<lang>/LC_MESSAGES/messages.po
source_file = marshmallow_utils/translations/messages.pot
source_lang = en
type = PO
